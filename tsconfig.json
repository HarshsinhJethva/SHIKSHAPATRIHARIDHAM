{
  "extends": "@react-native/typescript-config/tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@components/*": [
        "app/src/components/*"
      ],
      "@utils/*": [
        "app/utils/*"
      ],
      "@screens/*": [
        "app/src/screens/*"
      ],
      "@assets/*": [
        "app/assets/*"
      ]
    }
  }
}